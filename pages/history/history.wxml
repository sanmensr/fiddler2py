<!--history.wxml-->
<view class="container">
  <view class="title">📚 历史记录</view>
  
  <!-- 筛选器 -->
  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x="true">
      <view class="filter-list">
        <view 
          wx:for="{{filters}}" 
          wx:key="id" 
          class="filter-item {{selectedFilter === item.id ? 'active' : ''}}"
          data-filter="{{item.id}}"
          bindtap="onFilterChange"
        >
          <text class="filter-icon">{{item.icon}}</text>
          <text class="filter-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{isEmpty}}" class="empty-state">
    <view class="empty-icon">🔮</view>
    <view class="empty-title">暂无运势记录</view>
    <view class="empty-desc">快去为你的萌宠占卜一下吧！</view>
    <button class="btn-primary" bindtap="goToFortune">开始占卜</button>
  </view>

  <!-- 历史记录列表 -->
  <view wx:else class="history-list">
    <view 
      wx:for="{{filteredHistory}}" 
      wx:key="index" 
      class="history-item card"
      data-index="{{index}}"
      bindtap="viewDetail"
    >
      <!-- 记录头部 -->
      <view class="item-header">
        <view class="item-title">
          <text class="title-icon">{{item.type === 'today' ? '🌅' : item.type === 'week' ? '📅' : item.type === 'month' ? '🗓️' : item.type === 'love' ? '💕' : item.type === 'health' ? '🏥' : '💰'}}</text>
          <text class="title-text">{{item.typeName}}</text>
        </view>
        <view class="item-date">{{formatDate(item.date)}}</view>
      </view>

      <!-- 宠物信息 -->
      <view class="item-pet">
        <text class="pet-name">{{item.petName}}</text>
        <text class="pet-label">的运势</text>
      </view>

      <!-- 运势概览 -->
      <view class="item-scores">
        <view class="score-overview">
          <view class="score-item">
            <view class="score-label">综合</view>
            <view class="score-value" style="color: {{getScoreColor(item.scores.overall)}}">
              {{item.scores.overall}}%
            </view>
          </view>
          <view class="score-item">
            <view class="score-label">爱情</view>
            <view class="score-value" style="color: {{getScoreColor(item.scores.love)}}">
              {{item.scores.love}}%
            </view>
          </view>
          <view class="score-item">
            <view class="score-label">健康</view>
            <view class="score-value" style="color: {{getScoreColor(item.scores.health)}}">
              {{item.scores.health}}%
            </view>
          </view>
          <view class="score-item">
            <view class="score-label">财富</view>
            <view class="score-value" style="color: {{getScoreColor(item.scores.wealth)}}">
              {{item.scores.wealth}}%
            </view>
          </view>
        </view>
      </view>

      <!-- 幸运元素预览 -->
      <view class="item-lucky">
        <view class="lucky-preview">
          <view class="lucky-color-preview" style="background: {{item.luckyColor}}"></view>
          <text class="lucky-number-preview">{{item.luckyNumber}}</text>
          <text class="lucky-item-preview">{{item.luckyItem}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="item-actions" catchtap="stopPropagation">
        <view 
          class="action-btn delete-btn" 
          data-index="{{index}}"
          catchtap="deleteItem"
        >
          🗑️
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{!isEmpty}}" class="bottom-actions">
    <button class="btn-secondary" bindtap="shareHistory">📤 分享记录</button>
    <button class="btn-danger" bindtap="clearAllHistory">🗑️ 清空记录</button>
  </view>

  <!-- 统计信息 -->
  <view wx:if="{{!isEmpty}}" class="stats-section card">
    <view class="stats-title">📊 统计信息</view>
    <view class="stats-content">
      <view class="stat-item">
        <view class="stat-label">总占卜次数</view>
        <view class="stat-value">{{fortuneHistory.length}}</view>
      </view>
      <view class="stat-item">
        <view class="stat-label">当前筛选</view>
        <view class="stat-value">{{filteredHistory.length}}</view>
      </view>
    </view>
  </view>
</view>
